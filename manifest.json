{
  "manifest_version": 3,
  "name": "Peeksy",
  "description": "ALT+click any link to preview it in a floating overlay window",
  "version": "1.2.0",
  "minimum_chrome_version": "121",
  "permissions": [
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "preview-focused-link": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Preview the focused link (or close the open preview)"
    }
  },
  "action": {
    "default_title": "Peeksy",
    "default_popup": "options.html?popup",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
